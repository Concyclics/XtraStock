[Unit]
Description=Finance pipeline - bounded recent Meilisearch refresh
After=network-online.target
Wants=network-online.target

[Service]
Environment=XTRASTOCK_CONFIG=@REPO@/config/local.toml
Environment=XTRASTOCK_ENV_FILE=@REPO@/.env
Environment=PATH=@REPO@/services/model_gateway/bin:@REPO@/.venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Asia/Shanghai
Type=oneshot
WorkingDirectory=@APP@
TimeoutStartSec=2h
ExecStart=@REPO@/.venv/bin/python scripts/search/sync_document_search.py --skip-schema --skip-fts --days 2 --fetch-size 50 --meili-batch-size 50 --meili-body-chars 1800
