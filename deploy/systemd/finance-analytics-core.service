[Unit]
Description=Finance pipeline - production analytics and factor refresh
After=network-online.target finance-reports-daily.service
Wants=network-online.target
StartLimitIntervalSec=2h
StartLimitBurst=4

[Service]
Environment=XTRASTOCK_CONFIG=@REPO@/config/local.toml
Environment=XTRASTOCK_ENV_FILE=@REPO@/.env
Environment=PATH=@REPO@/services/model_gateway/bin:@REPO@/.venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Asia/Shanghai
Type=oneshot
WorkingDirectory=@APP@
EnvironmentFile=-@REPO@/.env
TimeoutStartSec=3h
Restart=on-failure
RestartSec=15m
ExecStart=@REPO@/.venv/bin/python scripts/pipeline/analytics_core_refresh.py
