[Unit]
Description=Finance pipeline - daily factor feature and score materialization
After=network-online.target finance-knowledge-graph.service
Wants=network-online.target
StartLimitIntervalSec=3h
StartLimitBurst=4

[Service]
Environment=XTRASTOCK_CONFIG=@REPO@/config/local.toml
Environment=XTRASTOCK_ENV_FILE=@REPO@/.env
Environment=PATH=@REPO@/services/model_gateway/bin:@REPO@/.venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Asia/Shanghai
Type=oneshot
WorkingDirectory=@APP@
TimeoutStartSec=8h
Restart=on-failure
RestartSec=20m
ExecStart=@REPO@/.venv/bin/python scripts/pipeline/factor_daily_refresh.py
