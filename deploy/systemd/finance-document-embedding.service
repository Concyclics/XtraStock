[Unit]
Description=Finance pipeline - local semantic document embeddings
After=network-online.target finagent-api-gateway.service
Wants=network-online.target finagent-api-gateway.service

[Service]
Environment=XTRASTOCK_CONFIG=@REPO@/config/local.toml
Environment=XTRASTOCK_ENV_FILE=@REPO@/.env
Environment=PATH=@REPO@/services/model_gateway/bin:@REPO@/.venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Asia/Shanghai
Type=oneshot
WorkingDirectory=@APP@
EnvironmentFile=-@REPO@/.env
TimeoutStartSec=30m
Nice=15
IOSchedulingClass=idle
CPUQuota=50%
ExecStart=@REPO@/.venv/bin/python scripts/search/sync_document_embeddings.py --limit 1800 --batch-size 32 --max-seconds 1200
