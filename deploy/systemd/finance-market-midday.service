[Unit]
Description=Finance pipeline - midday market incremental crawl
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3h
StartLimitBurst=4

[Service]
Environment=XTRASTOCK_CONFIG=@REPO@/config/local.toml
Environment=XTRASTOCK_ENV_FILE=@REPO@/.env
Environment=PATH=@REPO@/services/model_gateway/bin:@REPO@/.venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Asia/Shanghai
Type=oneshot
WorkingDirectory=@APP@
TimeoutStartSec=6h
ExecStart=@REPO@/.venv/bin/python scripts/pipeline/daily_market_midday.py --workers 4
Restart=on-failure
RestartSec=15min
