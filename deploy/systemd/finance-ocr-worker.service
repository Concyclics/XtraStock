[Unit]
Description=Finance pipeline - continuous PDF OCR worker
After=network-online.target
After=finagent-api-gateway.service
Wants=network-online.target
Wants=finagent-api-gateway.service

[Service]
Environment=XTRASTOCK_CONFIG=@REPO@/config/local.toml
Environment=XTRASTOCK_ENV_FILE=@REPO@/.env
Environment=PATH=@REPO@/services/model_gateway/bin:@REPO@/.venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Asia/Shanghai
Type=simple
WorkingDirectory=@APP@
EnvironmentFile=-@REPO@/.env
ExecStartPre=@REPO@/.venv/bin/python @REPO@/services/model_gateway/wait_ocr_backend.py
TimeoutStartSec=20min
ExecStart=@REPO@/.venv/bin/python scripts/pipeline/ocr_worker.py --concurrency 8 --stale-minutes 30 --sync-every 0
Nice=10
IOSchedulingClass=idle
CPUQuota=200%
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
