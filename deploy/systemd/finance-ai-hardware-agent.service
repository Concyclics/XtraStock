[Unit]
Description=Finance pipeline - AI hardware Codex daily research agent
After=network-online.target
Wants=network-online.target

[Service]
Environment=XTRASTOCK_CONFIG=@REPO@/config/local.toml
Environment=XTRASTOCK_ENV_FILE=@REPO@/.env
Environment=PATH=@REPO@/services/model_gateway/bin:@REPO@/.venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Asia/Shanghai
Type=oneshot
WorkingDirectory=@APP@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-@REPO@/.env
Environment=FINANCE_DAILY_PROVIDER=openai_compatible
Environment=FINANCE_DAILY_MODEL=gpt-6-astra
Environment=FINANCE_DAILY_REASONING_EFFORT=high
Environment=FINANCE_DAILY_TIMEOUT_SECONDS=720
TimeoutStartSec=15min
ExecStart=@REPO@/.venv/bin/python scripts/pipeline/daily_ai_hardware_codex_agent.py

Environment=FINANCE_V3_PUBLISH=0
